<view class="navigation-screen">
  <map class="full-map" latitude="{{latitude}}" longitude="{{longitude}}" scale="17" show-location="true" markers="{{markers}}" polyline="{{polyline}}" />

  <view class="top-overlay" style="padding-top: {{safeTop}}px;">
    <button class="back-button" bindtap="backToRoute" aria-label="返回路线预览">‹</button>
    <view class="progress-card">
      <view class="metric-row">
        <view class="metric">
          <text class="metric-label">剩余距离</text>
          <text class="metric-value">{{remainingDistance}}</text>
        </view>
        <view class="metric-divider"></view>
        <view class="metric">
          <text class="metric-label">预计剩余时间</text>
          <text class="metric-value">{{remainingDuration}}</text>
        </view>
      </view>
      <view class="clock-line"><text>已走 {{walkedDistance}}</text><text>已用时 {{elapsedTime}}</text><text class="clock-value">{{clockTime}}</text></view>
    </view>
  </view>

  <view class="demo-notice">{{trackingStatus}}</view>
</view>
