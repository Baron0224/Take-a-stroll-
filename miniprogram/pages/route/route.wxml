<view class="page-wrap">
  <view class="route-heading">
    <button class="back" bindtap="backToSettings">← 返回设置</button>
    <view class="route-title">{{title}}</view>
    <view class="route-subtitle">{{subtitle}}</view>
  </view>

  <view class="map-wrap">
    <map class="map" latitude="{{latitude}}" longitude="{{longitude}}" scale="15" show-location="true" markers="{{markers}}" polyline="{{polyline}}" />
    <view class="demo-tag">示意轨迹 · 不是实际道路</view>
  </view>

  <view class="summary-card">
    <view><view class="distance">{{distanceText}}</view><view class="summary-caption">演示路线预览</view></view>
    <view class="duration">{{durationText}}</view>
  </view>

  <button class="reroll" bindtap="reroll">⟳　不喜欢？重新抽一条</button>
  <view class="actions">
    <button class="favorite {{favorite ? 'saved' : ''}}" bindtap="toggleFavorite">{{favorite ? '♥ 已收藏' : '♡ 收藏'}}</button>
    <button class="start" bindtap="startNavigation">开始导航　↗</button>
  </view>
  <button class="finish" bindtap="finishDemo">结束示例散步并查看记录</button>
  <view class="notice">当前轨迹为随机示意，不可用于真实导航。接入高德后会显示真实步行路线。</view>
</view>
