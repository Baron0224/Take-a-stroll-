<view class="page-wrap">
  <view class="heading">
    <button class="back" bindtap="backHome">← 返回散步</button>
    <view class="title">我的散步</view>
    <view class="subtitle">每一段路，都是留给自己的时间。</view>
  </view>

  <view class="profile-card">
    <button class="avatar-picker" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" aria-label="选择微信头像">
      <image wx:if="{{avatarUrl}}" class="avatar-image" src="{{avatarUrl}}" mode="aspectFill" />
      <text wx:else class="avatar-placeholder">🌱</text>
    </button>
    <view class="profile-info">
      <input class="nickname-input" type="nickname" value="{{nickname}}" placeholder="填写昵称" bindinput="onNicknameInput" />
      <view class="motto">头像由你选择，记录按当前微信账号保存。</view>
      <button class="save-profile" bindtap="saveProfile" loading="{{profileSaving}}">保存资料</button>
    </view>
  </view>

  <view class="stats">
    <view class="stat"><view class="number">{{totalDistance}}</view><view class="label">累计距离 · 公里</view></view>
    <view class="stat"><view class="number">{{totalDuration}}</view><view class="label">累计时长 · 分钟</view></view>
  </view>

  <view class="list-tabs">
    <view class="list-tab {{activeTab === 'records' ? 'active' : ''}}" data-tab="records" bindtap="selectTab">散步记录</view>
    <view class="list-tab {{activeTab === 'favorites' ? 'active' : ''}}" data-tab="favorites" bindtap="selectTab">我的收藏</view>
  </view>

  <view wx:if="{{activeTab === 'records'}}">
    <view class="records-heading"><text>每一次出发</text><text wx:if="{{records.length}}" class="clear" bindtap="clearRecords">清空</text></view>
    <view wx:if="{{!records.length}}" class="empty">完成一段散步后，记录会出现在这里。</view>
    <view wx:for="{{records}}" wx:key="index" class="record" data-id="{{item._id}}" bindtap="openRecord">
      <view class="record-icon">🌿</view>
      <view class="record-main">
        <view class="record-title">{{item.title}}</view>
        <view class="record-meta">{{item.date}} · {{item.duration}} 分钟</view>
      </view>
      <view class="record-distance">{{item.distance}} km</view>
    </view>
  </view>

  <view wx:if="{{activeTab === 'favorites'}}">
    <view class="records-heading"><text>喜欢的路线</text><text wx:if="{{favorites.length}}" class="clear" bindtap="clearFavorites">清空</text></view>
    <view wx:if="{{!favorites.length}}" class="empty">喜欢的路线会收藏在这里。</view>
    <view wx:for="{{favorites}}" wx:key="id" class="record">
      <view class="record-icon">♡</view>
      <view class="record-main">
        <view class="record-title">{{item.title}}</view>
        <view class="record-meta">{{item.date}} · {{item.duration}} 分钟</view>
      </view>
      <view class="record-distance">{{item.distance}} km</view>
      <button class="remove-favorite" data-id="{{item.id}}" bindtap="removeFavorite">移除</button>
    </view>
  </view>
</view>
