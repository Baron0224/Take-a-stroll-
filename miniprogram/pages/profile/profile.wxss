.page-wrap { padding-bottom: 60rpx; }
.heading { padding: 8rpx 38rpx 22rpx; }
.back { margin: 0; padding: 10rpx 0; border: 0; background: transparent; color: #7c8980; font-size: 24rpx; text-align: left; }
.back::after { border: 0; }
.title { margin-top: 16rpx; font-size: 42rpx; font-weight: 800; }
.subtitle { margin-top: 9rpx; color: #7c8980; font-size: 24rpx; }
.profile-card { display: flex; align-items: center; gap: 22rpx; margin: 12rpx 28rpx 20rpx; padding: 30rpx; border-radius: 28rpx; background: #e6eddb; }
.avatar { display: flex; width: 112rpx; height: 112rpx; align-items: center; justify-content: center; border-radius: 50%; background: #fffefa; font-size: 50rpx; }
.nickname { font-size: 30rpx; font-weight: 800; }
.motto { margin-top: 8rpx; color: #7c8980; font-size: 22rpx; }
.stats { display: flex; gap: 16rpx; margin: 0 28rpx; }
.stat { flex: 1; padding: 27rpx 24rpx; border: 1rpx solid #e5e6dc; border-radius: 22rpx; background: #fffefa; }
.number { font-size: 44rpx; font-weight: 800; letter-spacing: -2rpx; }
.label { margin-top: 7rpx; color: #7c8980; font-size: 21rpx; }
.records-heading { display: flex; justify-content: space-between; align-items: center; margin: 38rpx 34rpx 18rpx; font-size: 27rpx; font-weight: 800; }
.clear { color: #89958b; font-size: 21rpx; font-weight: 500; }
.empty { margin: 0 28rpx; padding: 58rpx 20rpx; border: 1rpx solid #e5e6dc; border-radius: 22rpx; background: #fffefa; color: #9aa39b; text-align: center; font-size: 23rpx; }
.record { display: flex; align-items: center; gap: 18rpx; margin: 0 28rpx 12rpx; padding: 20rpx; border: 1rpx solid #e5e6dc; border-radius: 20rpx; background: #fffefa; }
.record-icon { display: flex; width: 82rpx; height: 82rpx; align-items: center; justify-content: center; border-radius: 20rpx; background: #eef2e6; font-size: 38rpx; }
.record-main { flex: 1; min-width: 0; }
.record-title { overflow: hidden; font-size: 23rpx; font-weight: 750; text-overflow: ellipsis; white-space: nowrap; }
.record-meta { margin-top: 8rpx; color: #7c8980; font-size: 19rpx; }
.record-distance { font-size: 22rpx; font-weight: 750; }

