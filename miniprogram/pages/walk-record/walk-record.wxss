page { min-height: 100vh; background: #f4f2ec; color: #292d27; }
.record-page { min-height: 100vh; padding: 24rpx 28rpx 50rpx; box-sizing: border-box; }
.map-wrap { height: 68vh; overflow: hidden; border-radius: 24rpx; background: #e7ebdf; }
.record-map { width: 100%; height: 100%; }
.summary { margin-top: 24rpx; padding: 30rpx; border: 1rpx solid #e5e3d9; border-radius: 22rpx; background: #fbfaf6; }
.summary-title { font-size: 28rpx; font-weight: 700; }
.summary-stats { display: flex; gap: 60rpx; margin-top: 24rpx; }
.summary-stats > view { display: flex; flex-direction: column; gap: 8rpx; }
.value { color: #3f5848; font-size: 36rpx; font-weight: 700; }
.label, .date, .hint { color: #85877d; font-size: 21rpx; }
.date { margin-top: 24rpx; }
.hint { margin-top: 18rpx; line-height: 1.6; }
